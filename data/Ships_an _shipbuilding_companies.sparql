# Ships and shipbuilding companies: size class distribution per company
# Корабли и судостроительные верфи: распределение по классам размеров
SELECT ?company ?companyLabel ?countryLabel ?shipsBuilt ?sizeClass
       (COUNT(?ship) AS ?shipsInClass)
WHERE {
  {
    SELECT ?company ?country (COUNT(?ship) AS ?shipsBuilt)
    WHERE {
      ?ship wdt:P31/wdt:P279* wd:Q11446;
            wdt:P176 ?company.
      OPTIONAL { ?company wdt:P17 ?country. }
    }
    GROUP BY ?company ?country
    HAVING (COUNT(?ship) >= 3)
  }

  ?ship wdt:P31/wdt:P279* wd:Q11446;
        wdt:P176 ?company;
        wdt:P2043 ?length.                        # только корабли с указанной длиной

  BIND(
    IF(?length < 25,   "1_малое (<25м)",           # лодки, катера
    IF(?length < 100,  "2_прибрежное (25-100м)",   # буксиры, паромы, корветы
    IF(?length < 130,  "3_mini-handy (100-130м)",  # малые грузовые
    IF(?length < 180,  "4_handysize (130-180м)",   # сухогрузы, фрегаты
    IF(?length < 200,  "5_handymax (180-200м)",    # балкеры, эсминцы
    IF(?length < 295,  "6_panamax (200-295м)",     # контейнеровозы, крейсеры
    IF(?length < 330,  "7_capesize (295-330м)",    # танкеры, авианосцы
                       "8_vlcc и крупнее (>330м)"  # супертанкеры, авианосцы США
    ))))))) AS ?sizeClass)

  OPTIONAL { ?company wdt:P17 ?country. }

  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en" }
}
GROUP BY ?company ?companyLabel ?countryLabel ?shipsBuilt ?sizeClass
