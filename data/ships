# Корабли и судостроительные фирмы с полным набором свойств: название компании,страна, количество построенных кораблей, средняя длина корабля, год постройки самого нового корабля
# Ships and shipbuilding companies with a full set of properties: company name, country, number of ships built, average ship length, year of construction of the newest ship
SELECT 
  ?companyLabel
  ?countryLabel
  ?shipsBuilt
  ?avgLength
  ?latestYear
  ?coordinates
WHERE {
  {
    SELECT 
      ?company
      ?country
      (COUNT(?ship) AS ?shipsBuilt)
      (AVG(?length) AS ?avgLength)
      (MAX(?yearBuilt) AS ?latestYear)
      (SAMPLE(?coords) AS ?coordinates)
    WHERE {
      ?ship wdt:P31/wdt:P279* wd:Q11446.
      ?ship wdt:P176 ?company.
      
      OPTIONAL { ?ship wdt:P2043 ?length. }
      OPTIONAL { ?ship wdt:P571 ?inception. BIND(YEAR(?inception) AS ?yearBuilt) }
      OPTIONAL { ?ship wdt:P729 ?serviceEntry. BIND(YEAR(?serviceEntry) AS ?yearBuilt) }
      
      OPTIONAL { ?company wdt:P17 ?country. }
      
      # === ПОЛУЧЕНИЕ КООРДИНАТ (три способа) ===
      OPTIONAL { ?company wdt:P625 ?coord1. }
      OPTIONAL { 
        ?company wdt:P159 ?hq.
        ?hq wdt:P625 ?coord2.
      }
      OPTIONAL { 
        ?company wdt:P740 ?location.
        ?location wdt:P625 ?coord3.
      }
      BIND(COALESCE(?coord1, ?coord2, ?coord3) AS ?coords)
    }
    GROUP BY ?company ?country
    HAVING (COUNT(?ship) >= 3)
  }
  
  # Получение названий
  SERVICE wikibase:label { 
    bd:serviceParam wikibase:language "ru,en". 
    ?company rdfs:label ?companyLabel.
    ?country rdfs:label ?countryLabel.
  }
}
ORDER BY DESC(?shipsBuilt)
